# GROQ_API_KEY: Required for Groq AI API calls (ultra-fast LPU inference).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# NASA_FIRMS_MAP_KEY: API MAP key for NASA FIRMS real-time satellite fire data feeds.
# Free keys can be generated at https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY="4ddefd0f9c4e2cf87148595c54a19642"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Admin SDK (Firestore) - optional. Persists classified fire data
# (location, wind, severity, fire type) as a live snapshot. Without these,
# the app runs normally but nothing is saved to Firestore.
# Get these from Firebase Console > Project Settings > Service Accounts >
# Generate new private key.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
