# GROQ_API_KEY: Required for Groq AI API calls (ultra-fast LPU inference).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# NASA_FIRMS_MAP_KEY: API MAP key for NASA FIRMS real-time satellite fire data feeds.
# Free keys can be generated at https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY="4ddefd0f9c4e2cf87148595c54a19642"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
