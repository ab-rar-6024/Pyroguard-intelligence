# GROQ_API_KEY: Required for Groq AI API calls (ultra-fast LPU inference).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# NASA_FIRMS_MAP_KEY: API MAP key for NASA FIRMS real-time satellite fire data feeds.
# Free keys can be generated at https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY="4ddefd0f9c4e2cf87148595c54a19642"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEOAPIFY_API_KEY: Used to resolve land cover (forest/farmland/industrial/
# urban) for fires with no nearby industrial facility, via the Geoapify
# Places API. Public OSM Overpass mirrors block/drop connections from
# cloud & serverless IP ranges (confirmed unreachable from this app's Vercel
# deployment - 0% success rate), so this is the reliable path in production.
# Free tier: 3,000 requests/day, no credit card required.
# Get one at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY="MY_GEOAPIFY_API_KEY"

# MAPBOX_ACCESS_TOKEN: Alternative land-cover source, used only if
# GEOAPIFY_API_KEY isn't set. Free tier: 100k requests/month, but requires a
# card on file. Get one at https://account.mapbox.com/access-tokens/
# If neither this nor GEOAPIFY_API_KEY is set, land cover falls back to the
# (frequently unreachable) OSM Overpass mirrors and most far-field fires
# will show as "Unclassified".
MAPBOX_ACCESS_TOKEN="MY_MAPBOX_ACCESS_TOKEN"

# Supabase (Postgres) - optional. Persists classified fire data (location,
# wind, severity, fire type) as a live snapshot, plus alerts and citizen
# fire reports. Without these, the app runs normally but nothing is saved.
# Run supabase/schema.sql once in the project's SQL Editor first, then get
# these from Project Settings > API. Use the service_role key (not anon) -
# it bypasses Row Level Security server-side, the same way the app
# previously used the Firebase Admin SDK to bypass Firestore rules.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
